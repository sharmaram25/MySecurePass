    <item android:width="108dp" android:height="108dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#0B0B0D" /></shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
